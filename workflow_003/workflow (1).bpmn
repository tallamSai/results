<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Department_Head" name="Department Head">
        <bpmn:flowNodeRef>Task_Reviews_the_evaluation_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approves_the_evaluation_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direct_Manager" name="Direct Manager">
        <bpmn:flowNodeRef>Task_Completes_the_performance_evaluation_for_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR_Representative" name="HR Representative">
        <bpmn:flowNodeRef>Task_Initiates_the_review_cycle_by_selecting__1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Schedules_a_feedback_meeting_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Closes_the_review_6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Initiates_the_review_cycle_by_selecting__1" name="Initiates the review cycle by selecting the employee and review period" />
    <bpmn:task id="Task_Completes_the_performance_evaluation_for_2" name="Completes the performance evaluation form with ratings and comments" />
    <bpmn:task id="Task_Reviews_the_evaluation_3" name="Reviews the evaluation" />
    <bpmn:exclusiveGateway id="Gateway_Approves_the_evaluation_4" name="Approves the evaluation" />
    <bpmn:task id="Task_Schedules_a_feedback_meeting_5" name="Schedules a feedback meeting" />
    <bpmn:task id="Task_Closes_the_review_6" name="Closes the review" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Initiates_the_review_cycle_by_selecting__1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Initiates_the_review_cycle_by_selecting__1" targetRef="Task_Completes_the_performance_evaluation_for_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Completes_the_performance_evaluation_for_2" targetRef="Task_Reviews_the_evaluation_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Reviews_the_evaluation_3" targetRef="Gateway_Approves_the_evaluation_4" />
    <bpmn:sequenceFlow id="Flow_5" name="Approved" sourceRef="Gateway_Approves_the_evaluation_4" targetRef="Task_Schedules_a_feedback_meeting_5" />
    <bpmn:sequenceFlow id="Flow_6" name="Rejected" sourceRef="Gateway_Approves_the_evaluation_4" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Schedules_a_feedback_meeting_5" targetRef="Task_Closes_the_review_6" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Closes_the_review_6" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="30" y="50" width="2650" height="200" />
      </bpmndi:BPMNShape>
