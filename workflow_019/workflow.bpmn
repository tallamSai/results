                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direct_Manager" name="Direct Manager">
        <bpmn:flowNodeRef>Gateway_Approves_the_visit_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_Requests_visitor_access_with_visitor_nam_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Reception_Desk" name="Reception Desk">
        <bpmn:flowNodeRef>Task_Prepares_visitor_badge_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Security_Officer" name="Security Officer">
        <bpmn:flowNodeRef>Task_Runs_background_check_for_sensitive_area_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Requests_visitor_access_with_visitor_nam_1" name="Requests visitor access with visitor name, company, visit date, visit purpose, and areas to access" />
    <bpmn:exclusiveGateway id="Gateway_Approves_the_visit_2" name="Approves the visit" />
    <bpmn:task id="Task_Runs_background_check_for_sensitive_area_3" name="Runs background check for sensitive areas" />
    <bpmn:task id="Task_Prepares_visitor_badge_4" name="Prepares visitor badge" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Requests_visitor_access_with_visitor_nam_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Requests_visitor_access_with_visitor_nam_1" targetRef="Gateway_Approves_the_visit_2" />
    <bpmn:sequenceFlow id="Flow_3" name="Approved" sourceRef="Gateway_Approves_the_visit_2" targetRef="Task_Runs_background_check_for_sensitive_area_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Rejected" sourceRef="Gateway_Approves_the_visit_2" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Runs_background_check_for_sensitive_area_3" targetRef="Task_Prepares_visitor_badge_4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Prepares_visitor_badge_4" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
