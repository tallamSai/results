<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Accounts_Payable_Clerk" name="Accounts Payable Clerk">
        <bpmn:flowNodeRef>Task_Receives_and_logs_invoice_with_vendor_na_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Schedules_payment_and_records_transactio_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Department_Manager" name="Department Manager">
        <bpmn:flowNodeRef>Task_Verifies_goods_or_services_received_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approves_or_rejects_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Manager" name="Finance Manager">
        <bpmn:flowNodeRef>Task_Reviews_for_budget_allocation_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Vendor" name="Vendor">
        <bpmn:flowNodeRef>Task_Receives_payment_confirmation_6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Receives_and_logs_invoice_with_vendor_na_1" name="Receives and logs invoice with vendor name, invoice number, amount, due date, and line items" />
    <bpmn:task id="Task_Verifies_goods_or_services_received_2" name="Verifies goods or services received" />
    <bpmn:exclusiveGateway id="Gateway_Approves_or_rejects_3" name="Approves or rejects" />
    <bpmn:task id="Task_Reviews_for_budget_allocation_4" name="Reviews for budget allocation" />
    <bpmn:task id="Task_Schedules_payment_and_records_transactio_5" name="Schedules payment and records transaction" />
    <bpmn:task id="Task_Receives_payment_confirmation_6" name="Receives payment confirmation" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Receives_and_logs_invoice_with_vendor_na_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Receives_and_logs_invoice_with_vendor_na_1" targetRef="Task_Verifies_goods_or_services_received_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Verifies_goods_or_services_received_2" targetRef="Gateway_Approves_or_rejects_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Approved" sourceRef="Gateway_Approves_or_rejects_3" targetRef="Task_Reviews_for_budget_allocation_4" />
    <bpmn:sequenceFlow id="Flow_5" name="Rejected" sourceRef="Gateway_Approves_or_rejects_3" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Reviews_for_budget_allocation_4" targetRef="Task_Schedules_payment_and_records_transactio_5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Schedules_payment_and_records_transactio_5" targetRef="Task_Receives_payment_confirmation_6" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Receives_payment_confirmation_6" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
