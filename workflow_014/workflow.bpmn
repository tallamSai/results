        <bpmn:flowNodeRef>Task_Checks_existing_licenses_and_vendor_opti_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Requests_software_with_software_name_ver_1" name="Requests software with software name, version, business justification, and number of licenses" />
    <bpmn:exclusiveGateway id="Gateway_Approves_business_need_2" name="Approves business need" />
    <bpmn:task id="Task_Checks_existing_licenses_and_vendor_opti_3" name="Checks existing licenses and vendor options" />
    <bpmn:task id="Task_Installs_software_and_assigns_license_5" name="Installs software and assigns license" />
    <bpmn:task id="Task_Confirms_software_is_working_6" name="Confirms software is working" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Requests_software_with_software_name_ver_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Requests_software_with_software_name_ver_1" targetRef="Gateway_Approves_business_need_2" />
    <bpmn:sequenceFlow id="Flow_3" name="Approved" sourceRef="Gateway_Approves_business_need_2" targetRef="Task_Checks_existing_licenses_and_vendor_opti_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Rejected" sourceRef="Gateway_Approves_business_need_2" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Checks_existing_licenses_and_vendor_opti_3" targetRef="Task_Installs_software_and_assigns_license_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Installs_software_and_assigns_license_5" targetRef="Task_Confirms_software_is_working_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Confirms_software_is_working_6" targetRef="EndEvent_1" />
  </bpmn:process>
