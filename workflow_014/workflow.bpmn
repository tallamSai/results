        <bpmn:flowNodeRef>Task_Confirms_software_is_working_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT_Administrator" name="IT Administrator">
        <bpmn:flowNodeRef>Task_Installs_software_and_assigns_license_5</bpmn:flowNodeRef>
      </bpmn:lane>
