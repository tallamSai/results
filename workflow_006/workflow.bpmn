<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direct_Manager" name="Direct Manager">
        <bpmn:flowNodeRef>Task_Verifies_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approves_or_rejects_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_Submits_expense_claim_with_expense_type__1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Receives_reimbursement_confirmation_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Officer" name="Finance Officer">
        <bpmn:flowNodeRef>Task_Reviews_for_policy_compliance_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Processes_payment_by_entering_payment_da_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Submits_expense_claim_with_expense_type__1" name="Submits expense claim with expense type, amount, date, description, and receipt upload" />
    <bpmn:task id="Task_Verifies_2" name="Verifies" />
    <bpmn:exclusiveGateway id="Gateway_Approves_or_rejects_3" name="Approves or rejects" />
    <bpmn:task id="Task_Reviews_for_policy_compliance_4" name="Reviews for policy compliance" />
    <bpmn:task id="Task_Processes_payment_by_entering_payment_da_5" name="Processes payment by entering payment date and transaction reference" />
    <bpmn:task id="Task_Receives_reimbursement_confirmation_6" name="Receives reimbursement confirmation" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Submits_expense_claim_with_expense_type__1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submits_expense_claim_with_expense_type__1" targetRef="Task_Verifies_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Verifies_2" targetRef="Gateway_Approves_or_rejects_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Approved" sourceRef="Gateway_Approves_or_rejects_3" targetRef="Task_Reviews_for_policy_compliance_4" />
    <bpmn:sequenceFlow id="Flow_5" name="Rejected" sourceRef="Gateway_Approves_or_rejects_3" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Reviews_for_policy_compliance_4" targetRef="Task_Processes_payment_by_entering_payment_da_5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Processes_payment_by_entering_payment_da_5" targetRef="Task_Receives_reimbursement_confirmation_6" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Receives_reimbursement_confirmation_6" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
