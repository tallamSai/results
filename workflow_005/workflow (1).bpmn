                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direct_Manager" name="Direct Manager">
        <bpmn:flowNodeRef>Task_Reviews_relevance_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approves_or_rejects_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_Submits_a_training_request_with_course_n_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Officer" name="Finance Officer">
        <bpmn:flowNodeRef>Task_Processes_payment_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR_Representative" name="HR Representative">
        <bpmn:flowNodeRef>Task_Enrolls_the_employee_and_sends_confirmat_6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Submits_a_training_request_with_course_n_1" name="Submits a training request with course name, training provider, cost, duration, and business justification" />
    <bpmn:task id="Task_Reviews_relevance_2" name="Reviews relevance" />
    <bpmn:exclusiveGateway id="Gateway_Approves_or_rejects_3" name="Approves or rejects" />
    <bpmn:task id="Task_Processes_payment_5" name="Processes payment" />
    <bpmn:task id="Task_Enrolls_the_employee_and_sends_confirmat_6" name="Enrolls the employee and sends confirmation with training details" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Submits_a_training_request_with_course_n_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submits_a_training_request_with_course_n_1" targetRef="Task_Reviews_relevance_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Reviews_relevance_2" targetRef="Gateway_Approves_or_rejects_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Approved" sourceRef="Gateway_Approves_or_rejects_3" targetRef="Task_Processes_payment_5" />
    <bpmn:sequenceFlow id="Flow_5" name="Rejected" sourceRef="Gateway_Approves_or_rejects_3" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Processes_payment_5" targetRef="Task_Enrolls_the_employee_and_sends_confirmat_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Enrolls_the_employee_and_sends_confirmat_6" targetRef="EndEvent_1" />
  </bpmn:process>
