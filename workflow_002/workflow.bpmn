<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direct_Manager" name="Direct Manager">
        <bpmn:flowNodeRef>Task_Reviews_leave_request_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approves_or_rejects_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_Submits_leave_request_with_leave_type_st_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Is_notified_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR_Representative" name="HR Representative">
        <bpmn:flowNodeRef>Task_Updates_leave_balance_and_records_approv_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Submits_leave_request_with_leave_type_st_1" name="Submits leave request with leave type, start date, end date, and reason" />
    <bpmn:task id="Task_Reviews_leave_request_2" name="Reviews leave request" />
    <bpmn:exclusiveGateway id="Gateway_Approves_or_rejects_3" name="Approves or rejects" />
    <bpmn:task id="Task_Updates_leave_balance_and_records_approv_5" name="Updates leave balance and records approved leave in the system" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:task id="Task_Is_notified_4" name="Is notified" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Submits_leave_request_with_leave_type_st_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submits_leave_request_with_leave_type_st_1" targetRef="Task_Reviews_leave_request_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Reviews_leave_request_2" targetRef="Gateway_Approves_or_rejects_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Approved" sourceRef="Gateway_Approves_or_rejects_3" targetRef="Task_Updates_leave_balance_and_records_approv_5" />
    <bpmn:sequenceFlow id="Flow_5" name="Rejected" sourceRef="Gateway_Approves_or_rejects_3" targetRef="Task_Is_notified_4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Updates_leave_balance_and_records_approv_5" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Is_notified_4" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="30" y="50" width="2050" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Direct_Manager_di" bpmnElement="Lane_Direct_Manager" isHorizontal="true">
        <dc:Bounds x="30" y="250" width="2050" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Employee_di" bpmnElement="Lane_Employee" isHorizontal="true">
        <dc:Bounds x="30" y="450" width="2050" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_HR_Representative_di" bpmnElement="Lane_HR_Representative" isHorizontal="true">
        <dc:Bounds x="30" y="650" width="2050" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
