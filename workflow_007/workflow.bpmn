    <bpmn:task id="Task_Reviews_visa_and_insurance_requirements_3" name="Reviews visa and insurance requirements" />
    <bpmn:task id="Task_Verifies_budget_and_issues_travel_advanc_4" name="Verifies budget and issues travel advance" />
    <bpmn:task id="Task_Submits_actual_expenses_for_reconciliati_5" name="Submits actual expenses for reconciliation" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Submits_travel_request_with_destination__1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submits_travel_request_with_destination__1" targetRef="Gateway_Approves_or_rejects_2" />
    <bpmn:sequenceFlow id="Flow_3" name="Approved" sourceRef="Gateway_Approves_or_rejects_2" targetRef="Task_Reviews_visa_and_insurance_requirements_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Rejected" sourceRef="Gateway_Approves_or_rejects_2" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Reviews_visa_and_insurance_requirements_3" targetRef="Task_Verifies_budget_and_issues_travel_advanc_4" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Verifies_budget_and_issues_travel_advanc_4" targetRef="Task_Submits_actual_expenses_for_reconciliati_5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Submits_actual_expenses_for_reconciliati_5" targetRef="EndEvent_1" />
  </bpmn:process>
