        <dc:Bounds x="1300" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Conducts_exit_interview_and_archives_emp_5_di" bpmnElement="Task_Conducts_exit_interview_and_archives_emp_5">
        <dc:Bounds x="1600" y="710" width="100" height="80" />
