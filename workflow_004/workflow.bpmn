<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Direct_Manager" name="Direct Manager">
        <bpmn:flowNodeRef>Task_Confirms_pending_work_handover_status_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Officer" name="Finance Officer">
        <bpmn:flowNodeRef>Task_Processes_final_settlement_with_pending__4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR_Representative" name="HR Representative">
        <bpmn:flowNodeRef>Task_Initiates_offboarding_by_entering_employ_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Conducts_exit_interview_and_archives_emp_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT_Administrator" name="IT Administrator">
        <bpmn:flowNodeRef>Task_Revokes_system_access_and_collects_equip_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Initiates_offboarding_by_entering_employ_1" name="Initiates offboarding by entering employee name, last working day, and exit reason" />
    <bpmn:task id="Task_Confirms_pending_work_handover_status_2" name="Confirms pending work handover status" />
    <bpmn:task id="Task_Revokes_system_access_and_collects_equip_3" name="Revokes system access and collects equipment including laptop, access card, and phone" />
    <bpmn:task id="Task_Processes_final_settlement_with_pending__4" name="Processes final settlement with pending salary, leave encashment, and deductions" />
    <bpmn:task id="Task_Conducts_exit_interview_and_archives_emp_5" name="Conducts exit interview and archives employee records" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Initiates_offboarding_by_entering_employ_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Initiates_offboarding_by_entering_employ_1" targetRef="Task_Confirms_pending_work_handover_status_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Confirms_pending_work_handover_status_2" targetRef="Task_Revokes_system_access_and_collects_equip_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Revokes_system_access_and_collects_equip_3" targetRef="Task_Processes_final_settlement_with_pending__4" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Processes_final_settlement_with_pending__4" targetRef="Task_Conducts_exit_interview_and_archives_emp_5" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Conducts_exit_interview_and_archives_emp_5" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="30" y="50" width="2350" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Direct_Manager_di" bpmnElement="Lane_Direct_Manager" isHorizontal="true">
