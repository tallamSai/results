    <bpmn:task id="Task_Implements_fix_or_workaround_5" name="Implements fix or workaround" />
    <bpmn:exclusiveGateway id="Gateway_Escalates_incident_if_complex_or_high_im_6" name="Escalates incident if complex or high impact" />
    <bpmn:task id="Task_Provides_guidance_or_additional_resource_7" name="Provides guidance or additional resources" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Reports_an_issue_by_submitting_a_ticket_1" />
