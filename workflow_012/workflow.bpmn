    <bpmn:sequenceFlow id="Flow_7" name="Approved" sourceRef="Gateway_Escalates_incident_if_complex_or_high_im_6" targetRef="Task_Provides_guidance_or_additional_resource_7" />
    <bpmn:sequenceFlow id="Flow_8" name="Rejected" sourceRef="Gateway_Escalates_incident_if_complex_or_high_im_6" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Provides_guidance_or_additional_resource_7" targetRef="EndEvent_1" />
