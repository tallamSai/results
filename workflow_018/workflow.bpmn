<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Employee" name="Employee">
        <bpmn:flowNodeRef>Task_Submits_maintenance_request_with_locatio_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirms_issue_resolved_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Facilities_Coordinator" name="Facilities Coordinator">
        <bpmn:flowNodeRef>Task_Reviews_and_assigns_priority_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Facilities_Manager" name="Facilities Manager">
        <bpmn:flowNodeRef>Gateway_Approves_or_rejects_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Maintenance_Technician" name="Maintenance Technician">
        <bpmn:flowNodeRef>Task_Inspects_and_provides_repair_estimate_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Completes_repair_and_documents_work_done_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Submits_maintenance_request_with_locatio_1" name="Submits maintenance request with location, issue type, description, and urgency" />
    <bpmn:task id="Task_Reviews_and_assigns_priority_2" name="Reviews and assigns priority" />
    <bpmn:task id="Task_Inspects_and_provides_repair_estimate_3" name="Inspects and provides repair estimate" />
    <bpmn:exclusiveGateway id="Gateway_Approves_or_rejects_4" name="Approves or rejects" />
    <bpmn:task id="Task_Completes_repair_and_documents_work_done_5" name="Completes repair and documents work done" />
    <bpmn:task id="Task_Confirms_issue_resolved_6" name="Confirms issue resolved" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Submits_maintenance_request_with_locatio_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submits_maintenance_request_with_locatio_1" targetRef="Task_Reviews_and_assigns_priority_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Reviews_and_assigns_priority_2" targetRef="Task_Inspects_and_provides_repair_estimate_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Inspects_and_provides_repair_estimate_3" targetRef="Gateway_Approves_or_rejects_4" />
    <bpmn:sequenceFlow id="Flow_5" name="Approved" sourceRef="Gateway_Approves_or_rejects_4" targetRef="Task_Completes_repair_and_documents_work_done_5" />
    <bpmn:sequenceFlow id="Flow_6" name="Rejected" sourceRef="Gateway_Approves_or_rejects_4" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Completes_repair_and_documents_work_done_5" targetRef="Task_Confirms_issue_resolved_6" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Confirms_issue_resolved_6" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
