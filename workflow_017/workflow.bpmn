    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Creates_RFQ_with_item_specifications_qua_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Creates_RFQ_with_item_specifications_qua_1" targetRef="Task_Sends_RFQ_to_approved_vendors_2" />
