    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Notifies_all_vendors_of_decision_5" targetRef="Task_Initiates_purchase_order_for_selected_ve_6" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Initiates_purchase_order_for_selected_ve_6" targetRef="EndEvent_1" />
