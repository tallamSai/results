                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Officer" name="Finance Officer">
        <bpmn:flowNodeRef>Task_Sets_up_payroll_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Hiring_Manager" name="Hiring Manager">
        <bpmn:flowNodeRef>Task_Reviews_the_submission_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Approves_or_rejects_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_HR_Representative" name="HR Representative">
        <bpmn:flowNodeRef>Task_Collects_new_hire_information_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Sends_welcome_package_confirmation_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT_Administrator" name="IT Administrator">
        <bpmn:flowNodeRef>Task_Provisions_system_access_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Collects_new_hire_information_1" name="Collects new hire information" />
    <bpmn:task id="Task_Reviews_the_submission_2" name="Reviews the submission" />
    <bpmn:exclusiveGateway id="Gateway_Approves_or_rejects_3" name="Approves or rejects" />
    <bpmn:task id="Task_Provisions_system_access_4" name="Provisions system access" />
    <bpmn:task id="Task_Sets_up_payroll_5" name="Sets up payroll" />
    <bpmn:task id="Task_Sends_welcome_package_confirmation_6" name="Sends welcome package confirmation" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Collects_new_hire_information_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Collects_new_hire_information_1" targetRef="Task_Reviews_the_submission_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Reviews_the_submission_2" targetRef="Gateway_Approves_or_rejects_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Approved" sourceRef="Gateway_Approves_or_rejects_3" targetRef="Task_Provisions_system_access_4" />
    <bpmn:sequenceFlow id="Flow_5" name="Rejected" sourceRef="Gateway_Approves_or_rejects_3" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Provisions_system_access_4" targetRef="Task_Sets_up_payroll_5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Sets_up_payroll_5" targetRef="Task_Sends_welcome_package_confirmation_6" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Sends_welcome_package_confirmation_6" targetRef="EndEvent_1" />
  </bpmn:process>
