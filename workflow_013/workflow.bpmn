      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Submits_change_request_with_change_title_1_di" bpmnElement="Task_Submits_change_request_with_change_title_1">
        <dc:Bounds x="400" y="710" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reviews_completeness_2_di" bpmnElement="Task_Reviews_completeness_2">
        <dc:Bounds x="700" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approves_or_rejects_based_on_risk_assess_3_di" bpmnElement="Gateway_Approves_or_rejects_based_on_risk_assess_3" isMarkerVisible="true">
        <dc:Bounds x="1025" y="325" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Implements_change_4_di" bpmnElement="Task_Implements_change_4">
        <dc:Bounds x="1300" y="670" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Verifies_success_and_closes_the_change_r_5_di" bpmnElement="Task_Verifies_success_and_closes_the_change_r_5">
        <dc:Bounds x="1600" y="670" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="1932" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="168" y="150" />
        <di:waypoint x="284" y="150" />
        <di:waypoint x="284" y="750" />
        <di:waypoint x="400" y="750" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="500" y="750" />
        <di:waypoint x="600" y="750" />
        <di:waypoint x="600" y="550" />
        <di:waypoint x="700" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="800" y="550" />
        <di:waypoint x="912" y="550" />
        <di:waypoint x="912" y="350" />
        <di:waypoint x="1025" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1075" y="350" />
        <di:waypoint x="1187" y="350" />
        <di:waypoint x="1187" y="710" />
        <di:waypoint x="1300" y="710" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1167" y="514" width="80" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1075" y="350" />
        <di:waypoint x="1503" y="350" />
        <di:waypoint x="1503" y="110" />
        <di:waypoint x="1932" y="110" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1483" y="246" width="80" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1400" y="710" />
        <di:waypoint x="1600" y="710" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1700" y="710" />
        <di:waypoint x="1816" y="710" />
        <di:waypoint x="1816" y="110" />
        <di:waypoint x="1932" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>