<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Change_Advisory_Board" name="Change Advisory Board">
        <bpmn:flowNodeRef>Gateway_Approves_or_rejects_based_on_risk_assess_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Change_Manager" name="Change Manager">
        <bpmn:flowNodeRef>Task_Reviews_completeness_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT_Staff" name="IT Staff">
        <bpmn:flowNodeRef>Task_Submits_change_request_with_change_title_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Implements_change_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verifies_success_and_closes_the_change_r_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Submits_change_request_with_change_title_1" name="Submits change request with change title, description, affected systems, implementation plan, rollback plan, and proposed date" />
    <bpmn:task id="Task_Reviews_completeness_2" name="Reviews completeness" />
    <bpmn:exclusiveGateway id="Gateway_Approves_or_rejects_based_on_risk_assess_3" name="Approves or rejects based on risk assessment" />
    <bpmn:task id="Task_Implements_change_4" name="Implements change" />
    <bpmn:task id="Task_Verifies_success_and_closes_the_change_r_5" name="Verifies success and closes the change request" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Submits_change_request_with_change_title_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submits_change_request_with_change_title_1" targetRef="Task_Reviews_completeness_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Reviews_completeness_2" targetRef="Gateway_Approves_or_rejects_based_on_risk_assess_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Approved" sourceRef="Gateway_Approves_or_rejects_based_on_risk_assess_3" targetRef="Task_Implements_change_4" />
    <bpmn:sequenceFlow id="Flow_5" name="Rejected" sourceRef="Gateway_Approves_or_rejects_based_on_risk_assess_3" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Implements_change_4" targetRef="Task_Verifies_success_and_closes_the_change_r_5" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Verifies_success_and_closes_the_change_r_5" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="30" y="50" width="2350" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Change_Advisory_Board_di" bpmnElement="Lane_Change_Advisory_Board" isHorizontal="true">
