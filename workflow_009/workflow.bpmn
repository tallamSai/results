<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Department_Manager" name="Department Manager">
        <bpmn:flowNodeRef>Task_Submits_annual_budget_request_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Analyst" name="Finance Analyst">
        <bpmn:flowNodeRef>Task_Reviews_and_provides_recommendations_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Allocates_budget_in_the_system_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Director" name="Finance Director">
        <bpmn:flowNodeRef>Gateway_Approves_requests_modifications_or_rejec_3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Submits_annual_budget_request_1" name="Submits annual budget request" />
    <bpmn:task id="Task_Reviews_and_provides_recommendations_2" name="Reviews and provides recommendations" />
    <bpmn:exclusiveGateway id="Gateway_Approves_requests_modifications_or_rejec_3" name="Approves, requests modifications, or rejects" />
    <bpmn:task id="Task_Allocates_budget_in_the_system_5" name="Allocates budget in the system" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Submits_annual_budget_request_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Submits_annual_budget_request_1" targetRef="Task_Reviews_and_provides_recommendations_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Reviews_and_provides_recommendations_2" targetRef="Gateway_Approves_requests_modifications_or_rejec_3" />
    <bpmn:sequenceFlow id="Flow_4" name="Approved" sourceRef="Gateway_Approves_requests_modifications_or_rejec_3" targetRef="Task_Allocates_budget_in_the_system_5" />
    <bpmn:sequenceFlow id="Flow_5" name="Rejected" sourceRef="Gateway_Approves_requests_modifications_or_rejec_3" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Allocates_budget_in_the_system_5" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="30" y="50" width="2050" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Department_Manager_di" bpmnElement="Lane_Department_Manager" isHorizontal="true">
