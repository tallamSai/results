                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Compliance_Officer" name="Compliance Officer">
        <bpmn:flowNodeRef>Task_Reviews_legal_documents_including_busine_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Officer" name="Finance Officer">
        <bpmn:flowNodeRef>Task_Sets_up_vendor_in_payment_system_with_ba_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement_Manager" name="Procurement Manager">
        <bpmn:flowNodeRef>Gateway_Gives_final_approval_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Procurement_Officer" name="Procurement Officer">
        <bpmn:flowNodeRef>Task_Initiates_vendor_registration_with_compa_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Vendor" name="Vendor">
        <bpmn:flowNodeRef>Task_Receives_confirmation_and_welcome_packag_5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Initiates_vendor_registration_with_compa_1" name="Initiates vendor registration with company name, contact person, email, phone, address, and services offered" />
    <bpmn:task id="Task_Reviews_legal_documents_including_busine_2" name="Reviews legal documents including business license and insurance certificates" />
    <bpmn:task id="Task_Sets_up_vendor_in_payment_system_with_ba_3" name="Sets up vendor in payment system with bank details and payment terms" />
    <bpmn:exclusiveGateway id="Gateway_Gives_final_approval_4" name="Gives final approval" />
    <bpmn:task id="Task_Receives_confirmation_and_welcome_packag_5" name="Receives confirmation and welcome package" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Initiates_vendor_registration_with_compa_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Initiates_vendor_registration_with_compa_1" targetRef="Task_Reviews_legal_documents_including_busine_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Reviews_legal_documents_including_busine_2" targetRef="Task_Sets_up_vendor_in_payment_system_with_ba_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Sets_up_vendor_in_payment_system_with_ba_3" targetRef="Gateway_Gives_final_approval_4" />
    <bpmn:sequenceFlow id="Flow_5" name="Approved" sourceRef="Gateway_Gives_final_approval_4" targetRef="Task_Receives_confirmation_and_welcome_packag_5" />
    <bpmn:sequenceFlow id="Flow_6" name="Rejected" sourceRef="Gateway_Gives_final_approval_4" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Receives_confirmation_and_welcome_packag_5" targetRef="EndEvent_1" />
  </bpmn:process>
