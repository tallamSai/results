    <bpmn:sequenceFlow id="Flow_4" name="Rejected" sourceRef="Gateway_Approves_the_business_need_2" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Provisions_access_and_sends_credentials_4" targetRef="EndEvent_1" />
