      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Drafts_contract_with_vendor_name_contrac_1_di" bpmnElement="Task_Drafts_contract_with_vendor_name_contrac_1">
        <dc:Bounds x="400" y="310" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Reviews_and_suggests_modifications_2_di" bpmnElement="Task_Reviews_and_suggests_modifications_2">
        <dc:Bounds x="700" y="710" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirms_budget_availability_3_di" bpmnElement="Task_Confirms_budget_availability_3">
        <dc:Bounds x="1000" y="510" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Checks_if_value_exceeds_50000_4_di" bpmnElement="Gateway_Checks_if_value_exceeds_50000_4" isMarkerVisible="true">
        <dc:Bounds x="1325" y="125" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Finalizes_and_sends_for_vendor_signature_6_di" bpmnElement="Task_Finalizes_and_sends_for_vendor_signature_6">
        <dc:Bounds x="1600" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Archives_and_activates_the_contract_7_di" bpmnElement="Task_Archives_and_activates_the_contract_7">
        <dc:Bounds x="1900" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="2232" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="168" y="150" />
        <di:waypoint x="284" y="150" />
        <di:waypoint x="284" y="350" />
        <di:waypoint x="400" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="500" y="350" />
        <di:waypoint x="600" y="350" />
        <di:waypoint x="600" y="750" />
        <di:waypoint x="700" y="750" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="800" y="750" />
        <di:waypoint x="900" y="750" />
        <di:waypoint x="900" y="550" />
        <di:waypoint x="1000" y="550" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="1100" y="550" />
        <di:waypoint x="1212" y="550" />
        <di:waypoint x="1212" y="150" />
        <di:waypoint x="1325" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1375" y="150" />
        <di:waypoint x="1487" y="150" />
        <di:waypoint x="1487" y="310" />
        <di:waypoint x="1600" y="310" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1467" y="214" width="80" height="16" />
