      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1375" y="150" />
        <di:waypoint x="1717" y="150" />
        <di:waypoint x="1717" y="110" />
        <di:waypoint x="2232" y="110" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1783" y="146" width="80" height="16" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1700" y="310" />
        <di:waypoint x="1900" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="2000" y="310" />
        <di:waypoint x="2116" y="310" />
        <di:waypoint x="2116" y="110" />
        <di:waypoint x="2232" y="110" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>