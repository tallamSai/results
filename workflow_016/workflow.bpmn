<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" 
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" 
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" 
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1" 
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_System" name="System">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Checks_if_value_exceeds_50000_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Contract_Manager" name="Contract Manager">
        <bpmn:flowNodeRef>Task_Drafts_contract_with_vendor_name_contrac_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Finalizes_and_sends_for_vendor_signature_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Archives_and_activates_the_contract_7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Finance_Director" name="Finance Director">
        <bpmn:flowNodeRef>Task_Confirms_budget_availability_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal_Counsel" name="Legal Counsel">
        <bpmn:flowNodeRef>Task_Reviews_and_suggests_modifications_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:task id="Task_Drafts_contract_with_vendor_name_contrac_1" name="Drafts contract with vendor name, contract type, value, duration, and key terms" />
    <bpmn:task id="Task_Reviews_and_suggests_modifications_2" name="Reviews and suggests modifications" />
    <bpmn:task id="Task_Confirms_budget_availability_3" name="Confirms budget availability" />
    <bpmn:exclusiveGateway id="Gateway_Checks_if_value_exceeds_50000_4" name="Checks if value exceeds 50000" />
    <bpmn:task id="Task_Finalizes_and_sends_for_vendor_signature_6" name="Finalizes and sends for vendor signature" />
    <bpmn:task id="Task_Archives_and_activates_the_contract_7" name="Archives and activates the contract" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_Drafts_contract_with_vendor_name_contrac_1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Drafts_contract_with_vendor_name_contrac_1" targetRef="Task_Reviews_and_suggests_modifications_2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Reviews_and_suggests_modifications_2" targetRef="Task_Confirms_budget_availability_3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Confirms_budget_availability_3" targetRef="Gateway_Checks_if_value_exceeds_50000_4" />
    <bpmn:sequenceFlow id="Flow_5" name="Approved" sourceRef="Gateway_Checks_if_value_exceeds_50000_4" targetRef="Task_Finalizes_and_sends_for_vendor_signature_6" />
    <bpmn:sequenceFlow id="Flow_6" name="Rejected" sourceRef="Gateway_Checks_if_value_exceeds_50000_4" targetRef="EndEvent_1" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Finalizes_and_sends_for_vendor_signature_6" targetRef="Task_Archives_and_activates_the_contract_7" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Archives_and_activates_the_contract_7" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="Lane_System_di" bpmnElement="Lane_System" isHorizontal="true">
        <dc:Bounds x="30" y="50" width="2650" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Contract_Manager_di" bpmnElement="Lane_Contract_Manager" isHorizontal="true">
